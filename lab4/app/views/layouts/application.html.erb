<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || 'Менеджер проєктів' %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <%= stylesheet_link_tag 'application', 'data-turbo-track': 'reload' %>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
      <div class="container">
        <%= link_to 'Менеджер проєктів', root_path, class: 'navbar-brand' %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navMenu">
          <ul class="navbar-nav me-auto">
            <li class="nav-item">
              <%= link_to 'Всі проєкти', projects_path, class: 'nav-link' %>
            </li>
            <li class="nav-item">
              <%= link_to 'Активні', in_progress_projects_path, class: 'nav-link' %>
            </li>
            <li class="nav-item">
              <%= link_to 'Категорії', categories_path, class: 'nav-link' %>
            </li>
            <li class="nav-item">
              <%= link_to '+ Новий проєкт', new_project_path, class: 'nav-link' %>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <div class="container mt-2">
      <% flash.each do |type, message| %>
        <% css = type.to_s == 'notice' ? 'alert-success' : 'alert-danger' %>
        <div class="alert <%= css %> alert-dismissible fade show" role="alert">
          <%= message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>

      <%= yield %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <%= yield :scripts %>
  </body>
</html>
