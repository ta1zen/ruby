<div class="d-flex justify-content-between align-items-center mb-3">
  <h1><%= @project.title %></h1>
  <div class="d-flex gap-2">
    <%= link_to 'Редагувати', edit_project_path(@project), class: 'btn btn-outline-secondary' %>
    <%= button_to 'Видалити', @project, method: :delete,
                  data: { turbo_confirm: 'Видалити проєкт?' },
                  class: 'btn btn-outline-danger' %>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <dl class="row mb-0">
      <dt class="col-sm-3">Клієнт</dt>
      <dd class="col-sm-9"><%= @project.client %></dd>

      <dt class="col-sm-3">Категорія</dt>
      <dd class="col-sm-9"><%= @project.category %></dd>

      <dt class="col-sm-3">Тег</dt>
      <dd class="col-sm-9"><%= @project.main_tag %></dd>

      <dt class="col-sm-3">Початок</dt>
      <dd class="col-sm-9"><%= @project.start_date %></dd>

      <dt class="col-sm-3">Дедлайн</dt>
      <dd class="col-sm-9"><%= deadline_badge(@project) %></dd>

      <dt class="col-sm-3">Бюджет</dt>
      <dd class="col-sm-9"><%= number_to_currency(@project.budget, unit: 'грн', format: '%n %u') %></dd>

      <dt class="col-sm-3">Статус</dt>
      <dd class="col-sm-9"><%= status_badge(@project) %></dd>
    </dl>
  </div>
</div>

<p class="mt-3">
  <%= link_to '← До списку', projects_path, class: 'btn btn-link' %>
</p>
