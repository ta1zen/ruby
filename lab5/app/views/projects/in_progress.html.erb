<div class="d-flex justify-content-between align-items-center mb-3">
  <h1>Активні проєкти <span class="badge bg-primary"><%= @projects.count %></span></h1>
</div>

<% if @projects.any? %>
  <table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
      <tr>
        <th>Назва</th>
        <th>Клієнт</th>
        <th>Категорія</th>
        <th>Дедлайн</th>
        <th>Бюджет</th>
        <th>Дії</th>
      </tr>
    </thead>
    <tbody>
      <% @projects.each do |project| %>
        <tr>
          <td><%= link_to project.title, project %></td>
          <td><%= project.client %></td>
          <td><%= project.category %></td>
          <td><%= deadline_badge(project) %></td>
          <td><%= number_to_currency(project.budget, unit: 'грн', format: '%n %u') %></td>
          <td>
            <%= link_to 'Переглянути', project, class: 'btn btn-sm btn-outline-primary' %>
            <%= link_to 'Редагувати', edit_project_path(project), class: 'btn btn-sm btn-outline-secondary' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div class="alert alert-info">Наразі немає активних проєктів.</div>
<% end %>
