<%# Partial форми — використовується у new.html.erb та edit.html.erb %>
<%= form_with(model: project, class: 'needs-validation', novalidate: true) do |f| %>
  <% if project.errors.any? %>
    <div class="alert alert-danger">
      <strong><%= project.errors.count %> помилок завадили зберегти проєкт:</strong>
      <ul class="mb-0">
        <% project.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :title, 'Назва', class: 'form-label' %>
    <%= f.text_field :title, class: 'form-control', required: true %>
    <div class="invalid-feedback">Введіть назву проєкту.</div>
  </div>

  <div class="mb-3">
    <%= f.label :category, 'Категорія', class: 'form-label' %>
    <%# Випадаючий список з існуючих категорій через pluck %>
    <%= f.select :category, Category.pluck(:name),
                 { include_blank: '— Оберіть категорію —' },
                 class: 'form-select' %>
  </div>

  <div class="mb-3">
    <%= f.label :main_tag, 'Основний тег', class: 'form-label' %>
    <%= f.text_field :main_tag, class: 'form-control' %>
  </div>

  <div class="mb-3">
    <%= f.label :client, 'Клієнт', class: 'form-label' %>
    <%= f.text_field :client, class: 'form-control', required: true %>
    <div class="invalid-feedback">Введіть ім'я клієнта.</div>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= f.label :start_date, 'Дата початку', class: 'form-label' %>
      <%= f.date_field :start_date, class: 'form-control', required: true %>
      <div class="invalid-feedback">Вкажіть дату початку.</div>
    </div>
    <div class="col-md-6 mb-3">
      <%= f.label :deadline, 'Дедлайн', class: 'form-label' %>
      <%= f.date_field :deadline, class: 'form-control', required: true %>
      <div class="invalid-feedback">Вкажіть дедлайн.</div>
    </div>
  </div>

  <div class="mb-3">
    <%= f.label :budget, 'Бюджет (грн)', class: 'form-label' %>
    <%= f.number_field :budget, step: 0.01, min: 0, class: 'form-control', required: true %>
    <div class="invalid-feedback">Введіть бюджет (не менше 0).</div>
  </div>

  <div class="mb-3">
    <%= f.label :status, 'Статус', class: 'form-label' %>
    <%# Enum-ключі з моделі %>
    <%= f.select :status, Project.statuses.keys, {}, class: 'form-select' %>
  </div>

  <%# Нове поле (lab5) — опис проєкту. text — необмежений текст, string — до ~255 символів %>
  <div class="mb-3">
    <%= f.label :description, 'Опис', class: 'form-label' %>
    <%= f.text_area :description, rows: 4, class: 'form-control' %>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit class: 'btn btn-primary' %>
    <%= link_to 'Скасувати', projects_path, class: 'btn btn-secondary' %>
  </div>
<% end %>

<% content_for :scripts do %>
  <script>
    (() => {
      const form = document.querySelector('.needs-validation');
      if (!form) return;
      form.addEventListener('submit', (event) => {
        if (!form.checkValidity()) {
          event.preventDefault();
          event.stopPropagation();
        }
        form.classList.add('was-validated');
      });
    })();
  </script>
<% end %>
