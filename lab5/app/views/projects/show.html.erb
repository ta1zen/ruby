<div class="d-flex justify-content-between align-items-center mb-3">
  <h1><%= @project.title %></h1>
  <div class="d-flex gap-2">
    <%= link_to 'Редагувати', edit_project_path(@project), class: 'btn btn-outline-secondary' %>
    <%= button_to 'Видалити', @project, method: :delete,
                  data: { turbo_confirm: 'Видалити проєкт?' },
                  class: 'btn btn-outline-danger' %>
  </div>
</div>

<div class="card mb-4">
  <div class="card-body">
    <dl class="row mb-0">
      <dt class="col-sm-3">Клієнт</dt>
      <dd class="col-sm-9"><%= @project.client %></dd>

      <dt class="col-sm-3">Категорія</dt>
      <dd class="col-sm-9"><%= @project.category %></dd>

      <dt class="col-sm-3">Тег</dt>
      <dd class="col-sm-9"><%= @project.main_tag %></dd>

      <dt class="col-sm-3">Початок</dt>
      <dd class="col-sm-9"><%= @project.start_date %></dd>

      <dt class="col-sm-3">Дедлайн</dt>
      <dd class="col-sm-9"><%= deadline_badge(@project) %></dd>

      <dt class="col-sm-3">Бюджет</dt>
      <dd class="col-sm-9"><%= number_to_currency(@project.budget, unit: 'грн', format: '%n %u') %></dd>

      <dt class="col-sm-3">Статус</dt>
      <dd class="col-sm-9"><%= status_badge(@project) %></dd>

      <% if @project.description.present? %>
        <dt class="col-sm-3">Опис</dt>
        <dd class="col-sm-9"><%= simple_format(@project.description) %></dd>
      <% end %>
    </dl>
  </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
  <h2>Команда проєкту</h2>
  <%= link_to '+ Додати учасника', new_project_team_member_path(@project), class: 'btn btn-sm btn-outline-primary' %>
</div>

<% if @team_members.any? %>
  <table class="table table-sm table-striped align-middle mb-4">
    <thead class="table-dark">
      <tr><th>Ім'я</th><th>Роль</th><th>Дії</th></tr>
    </thead>
    <tbody>
      <% @team_members.each do |member| %>
        <tr>
          <td><%= member.name %></td>
          <td><%= member.role.presence || '—' %></td>
          <td>
            <%= link_to 'Редагувати', edit_project_team_member_path(@project, member), class: 'btn btn-sm btn-outline-secondary' %>
            <%= button_to 'Видалити', project_team_member_path(@project, member), method: :delete,
                          data: { turbo_confirm: 'Видалити учасника?' },
                          class: 'btn btn-sm btn-outline-danger' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="text-muted">Команда ще не сформована.</p>
<% end %>

<p><%= link_to '← До списку', projects_path, class: 'btn btn-link' %></p>
