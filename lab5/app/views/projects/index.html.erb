<div class="d-flex justify-content-between align-items-center mb-3">
  <h1>Усі проєкти</h1>
  <%= link_to '+ Новий проєкт', new_project_path, class: 'btn btn-primary' %>
</div>

<% if @projects.any? %>
  <table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
      <tr>
        <th>Назва</th>
        <th>Клієнт</th>
        <th>Категорія</th>
        <th>Дедлайн</th>
        <th>Бюджет</th>
        <th>Статус</th>
        <th>Дії</th>
      </tr>
    </thead>
    <tbody>
      <% @projects.each do |project| %>
        <tr>
          <td><%= link_to project.title, project %></td>
          <td><%= project.client %></td>
          <td><%= project.category %></td>
          <td><%= deadline_badge(project) %></td>
          <td><%= number_to_currency(project.budget, unit: 'грн', format: '%n %u') %></td>
          <td><%= status_badge(project) %></td>
          <td>
            <%= link_to 'Редагувати', edit_project_path(project), class: 'btn btn-sm btn-outline-secondary' %>
            <%= button_to 'Видалити', project, method: :delete,
                          data: { turbo_confirm: 'Видалити проєкт?' },
                          class: 'btn btn-sm btn-outline-danger' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div class="alert alert-info">
    Проєктів ще немає. <%= link_to 'Додати перший', new_project_path %>.
  </div>
<% end %>
