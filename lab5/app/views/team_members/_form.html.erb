<%= form_with(model: [@project, @team_member]) do |f| %>
  <% if @team_member.errors.any? %>
    <div class="alert alert-danger">
      <strong><%= @team_member.errors.count %> помилок завадили зберегти учасника:</strong>
      <ul class="mb-0">
        <% @team_member.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, "Ім'я", class: 'form-label' %>
    <%= f.text_field :name, class: 'form-control' %>
  </div>

  <div class="mb-3">
    <%= f.label :role, 'Роль', class: 'form-label' %>
    <%= f.text_field :role, class: 'form-control', placeholder: 'Наприклад: розробник, дизайнер...' %>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit class: 'btn btn-primary' %>
    <%= link_to 'Скасувати', @project, class: 'btn btn-secondary' %>
  </div>
<% end %>
